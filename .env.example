# GEMINI_API_KEY: Optional for AI-assisted features on the server.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# SESSION_SECRET: Secret key used to sign HTTP-only session cookies.
SESSION_SECRET="change-this-to-a-long-random-secret"

# EXTERNAL_VIDEO_API_KEY: Optional server-side key for permitted external video discovery.
EXTERNAL_VIDEO_API_KEY=""
