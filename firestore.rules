rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'doptails@gmail.com'
      );
    }

    function isValidPublicProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'handle', 'preferredLanguage', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'handle', 'avatarUrl', 'preferredLanguage', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.handle is string && data.handle.size() >= 2 && data.handle.size() <= 64
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 512))
        && data.preferredLanguage is string && data.preferredLanguage.size() >= 2 && data.preferredLanguage.size() <= 40
        && data.updatedAt is timestamp;
    }

    function isValidPrivateInfo(data) {
      return data.keys().hasAll(['uid', 'email', 'historyPaused', 'personalizationEnabled', 'restrictedMode', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'historyPaused', 'personalizationEnabled', 'restrictedMode', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.historyPaused is bool
        && data.personalizationEnabled is bool
        && data.restrictedMode is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPreferenceDoc(data) {
      return data.keys().hasAll(['uid', 'theme', 'preferredLanguage', 'selectedInterests', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'theme', 'preferredLanguage', 'selectedInterests', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.theme is string && (data.theme == 'dark' || data.theme == 'light')
        && data.preferredLanguage is string && data.preferredLanguage.size() >= 2 && data.preferredLanguage.size() <= 40
        && data.selectedInterests is list
        && data.selectedInterests.size() <= 15
        && (data.selectedInterests.size() == 0 || (data.selectedInterests[0] is string && data.selectedInterests[0].size() <= 40))
        && data.updatedAt is timestamp;
    }

    // Startup connection check document (read-only)
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    // Split User Collections: Public Profile
    match /users/{userId}/public/profile {
      allow get: if isValidId(userId) && isVerifiedUser();
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidPublicProfile(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isValidPublicProfile(incoming())
        && (isOwner(userId) || isAdmin())
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'handle', 'avatarUrl', 'preferredLanguage', 'updatedAt']);
      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    // Split User Collections: Private PII Info
    match /users/{userId}/private/info {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidPrivateInfo(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isValidPrivateInfo(incoming())
        && (isOwner(userId) || isAdmin())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'historyPaused', 'personalizationEnabled', 'restrictedMode', 'updatedAt']);
      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    // User Preferences (strictly owner-scoped, no blanket list)
    match /user_preferences/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isVerifiedUser() && resource.data.uid == request.auth.uid;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidPreferenceDoc(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isValidPreferenceDoc(incoming())
        && (isOwner(userId) || isAdmin())
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['theme', 'preferredLanguage', 'selectedInterests', 'updatedAt']);
      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    // Admins registry (read-only to admins; cannot self-assign)
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isVerifiedUser() && (request.auth.uid == adminId || isAdmin());
      allow list, create, update, delete: if false;
    }
  }
}
