{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.js": {
      "maxDuration": 30,
      "includeFiles": "{firebase-applet-config.json,api/_app.mjs,node_modules/sql.js/dist/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index?__vercel_path=$1" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ]
}
