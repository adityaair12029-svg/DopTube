{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30,
      "includeFiles": "firebase-applet-config.json"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index?__vercel_path=$1" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ]
}
